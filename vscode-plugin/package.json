{
  "name": "ragx-knowledge-explorer",
  "displayName": "RAGX Knowledge Explorer",
  "description": "Explore o conhecimento que o RAGX indexou do seu projeto: busca semântica, grafo, dicionário e contexto para agentes — tudo local.",
  "version": "1.0.0-beta.1",
  "publisher": "ragx",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other", "Machine Learning", "Visualization"],
  "keywords": ["rag", "knowledge", "search", "graph", "mcp", "agent"],
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/qualquer-de-tudo/ragx.git",
    "directory": "vscode-plugin"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:ragx.toml",
    "workspaceContains:knowledge/manifest.json",
    "workspaceContains:.ragx/knowledge.db"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ragx",
          "title": "RAGX Knowledge",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "ragx": [
        {
          "type": "webview",
          "id": "ragx.explorer",
          "name": "Knowledge",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      { "command": "ragx.openExplorer", "title": "Open Knowledge Explorer", "category": "RAGX", "icon": "$(database)" },
      { "command": "ragx.search", "title": "Search Knowledge", "category": "RAGX", "icon": "$(search)" },
      { "command": "ragx.buildContext", "title": "Build Context", "category": "RAGX" },
      { "command": "ragx.exploreGraph", "title": "Explore Graph", "category": "RAGX" },
      { "command": "ragx.openDictionary", "title": "Open Dictionary", "category": "RAGX" },
      { "command": "ragx.sync", "title": "Sync Knowledge", "category": "RAGX", "icon": "$(sync)" },
      { "command": "ragx.securityScan", "title": "Run Security Scan", "category": "RAGX" },
      { "command": "ragx.openAgents", "title": "Open Agents", "category": "RAGX" },
      { "command": "ragx.trainAgent", "title": "Train Agent", "category": "RAGX" },
      { "command": "ragx.evaluateAgent", "title": "Run Agent Evaluation", "category": "RAGX" },
      { "command": "ragx.status", "title": "Show RAGX Status", "category": "RAGX" },
      { "command": "ragx.knowledgeForFile", "title": "View RAGX Knowledge for This File", "category": "RAGX", "icon": "$(book)" },
      { "command": "ragx.reconnect", "title": "Reconnect", "category": "RAGX" },
      { "command": "ragx.showLogs", "title": "Open Logs", "category": "RAGX", "icon": "$(output)" }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "ragx.knowledgeForFile",
          "when": "ragx.connected && editorIsOpen",
          "group": "navigation@9"
        }
      ],
      "editor/context": [
        {
          "command": "ragx.knowledgeForFile",
          "when": "ragx.connected",
          "group": "navigation@9"
        }
      ],
      "commandPalette": [
        { "command": "ragx.knowledgeForFile", "when": "ragx.connected && editorIsOpen" },
        { "command": "ragx.trainAgent", "when": "ragx.connected" },
        { "command": "ragx.evaluateAgent", "when": "ragx.connected" }
      ]
    },
    "keybindings": [
      {
        "command": "ragx.search",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "ragx.connected"
      }
    ],
    "configuration": {
      "title": "RAGX Knowledge",
      "properties": {
        "ragx.connection": {
          "type": "string",
          "enum": ["auto", "mcp", "cli"],
          "default": "auto",
          "markdownDescription": "Como falar com o RAGX. `mcp` mantém um processo quente (busca em milissegundos); `cli` roda um comando por consulta (mais lento, zero estado). `auto` tenta MCP e cai para CLI."
        },
        "ragx.command": {
          "type": "string",
          "default": "ragx",
          "description": "Executável do RAGX. Use o caminho absoluto se ele não estiver no PATH."
        },
        "ragx.mcpArgs": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["mcp", "serve"],
          "description": "Argumentos para subir o servidor MCP."
        },
        "ragx.autoSync": {
          "type": "string",
          "enum": ["off", "onSave", "onWorkspaceChange", "manual"],
          "default": "off",
          "markdownDescription": "Quando sincronizar o índice. `onSave` usa o sync **incremental**, nunca uma reindexação completa."
        },
        "ragx.searchMode": {
          "type": "string",
          "enum": ["hybrid", "semantic", "keyword"],
          "default": "hybrid",
          "description": "Modo padrão da busca."
        },
        "ragx.graphMaxDepth": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 4,
          "description": "Profundidade máxima ao expandir o grafo."
        },
        "ragx.maxVisibleNodes": {
          "type": "number",
          "default": 120,
          "minimum": 20,
          "maximum": 800,
          "markdownDescription": "Teto de nós desenhados ao mesmo tempo. Acima disso o grafo vira ruído e a renderização engasga."
        },
        "ragx.contextTokenBudget": {
          "type": "number",
          "default": 4000,
          "minimum": 500,
          "maximum": 32000,
          "description": "Orçamento de tokens do Context Builder."
        },
        "ragx.cacheEnabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Cachear dicionário, metadados e nós de grafo. Conteúdo bloqueado pelo Security Gate **nunca** é cacheado."
        },
        "ragx.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Mostrar o estado do RAGX na barra de status."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build:webview && npm run build:extension",
    "build:extension": "node esbuild.mjs --production",
    "build:webview": "vite build",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p webview/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "npm run typecheck",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "^1.90.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vscode/vsce": "^3.2.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.0",
    "happy-dom": "^15.11.6",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
